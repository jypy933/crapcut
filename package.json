{
  "name": "crapcut",
  "productName": "CrapCut",
  "version": "0.4.1",
  "description": "Turn a stream VOD into short captioned clips, locally.",
  "license": "MIT",
  "author": "jypy933",
  "homepage": "https://github.com/jypy933/crapcut",
  "repository": "github:jypy933/crapcut",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dev:ui": "vite --config vite.ui.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  }
}
